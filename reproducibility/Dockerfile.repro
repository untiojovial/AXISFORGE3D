# Slim validation image: statistics, extension tests, the native planner and a sample of planner decisions.
#
#   docker build -f reproducibility/Dockerfile.repro -t axisforge-repro .
#   docker run --rm -v /path/to/egad_pool:/data/pool:ro axisforge-repro bash reproducibility/docker_validate.sh
#
# Optional build argument EXTRA_CA_B64: a base64-encoded PEM certificate to trust (for builds behind a TLS-
# intercepting proxy). It is empty by default and changes nothing then.
FROM ubuntu:24.04
ARG EXTRA_CA_B64=""
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    CARGO_HTTP_CAINFO=/etc/ssl/certs/ca-certificates.crt SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config git \
        python3.12 python3.12-venv && rm -rf /var/lib/apt/lists/* \
    && if [ -n "$EXTRA_CA_B64" ]; then echo "$EXTRA_CA_B64" | base64 -d > /usr/local/share/ca-certificates/extra.crt && update-ca-certificates; fi
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
ENV PATH=/root/.cargo/bin:/venv/bin:$PATH OMP_NUM_THREADS=1 RAYON_NUM_THREADS=1
WORKDIR /work
COPY . /work
RUN python3.12 -m venv /venv && grep -E "^(numpy|scipy|scikit-learn|joblib|threadpoolctl|pytest|iniconfig|packaging|pluggy)==" \
        reproducibility/requirements-lock.txt > /tmp/req.txt && /venv/bin/pip install --no-cache-dir -r /tmp/req.txt
RUN cargo build --release --locked -p axisforge-cli && rm -rf target/release/deps target/release/build target/release/.fingerprint
